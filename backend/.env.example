# =============================================
#  Eeeztrip Backend — Environment Variables
# =============================================

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS whitelist)
FRONTEND_URL=http://localhost:3000

# JWT Secret — change this to a long random string in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_very_long_random_secret_string_in_production
JWT_EXPIRES_IN=7d

# Anthropic API Key
# Get yours at: https://console.anthropic.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Demo Account (pre-seeded on startup)
DEMO_EMAIL=demo@eeeztrip.com
DEMO_PASSWORD=demo123
DEMO_NAME=Demo Traveller
